<!DOCTYPE html>
<html id="page" lang="en">

<head>
    <link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"
        integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
    <link rel="stylesheet" href="/css/style.css" type="text/css">

</head>
<!--Head-->

<!--Body-->

<body>
    <div id="Heading">
        <title>Paul's Clothing Website</title>
        <div id="pageHeader">
            <h1>
                <b><i>
                        Established in 2025.
                    </i></b>
            </h1>
        </div>
    </div>
    <div id="logo">
        <header>
            <a href='/homepage'>
                <img src="/images/logo.jpeg" id="logo-img" alt="Paul's Clothing Logo" title="Our logo. " width="200"
                    height="200" />
            </a>
        </header>
        <br>
    </div>
    <div id="message">
        <p>
            Take a look at what jumpers we have in stock!
        </p>
    </div>
    <div id="product_Description">
        <br><input type="hidden" id=ID value=<%=ID%>></br>
            <h1 id="Name"><%=Name%></h1>
            <h1 id="Price"><%=Price%></h1>
            <h1 id="Category"><%=Category%></h1>
        </input>
    </div>
    <div id="image_Box">
        <img id="images" src="/images/products_db/6.jpeg">
    </div>
    <div id="numberDropDown">
    <br>
        <select id="quantity" name="quantity">
            <option value="0">0</option>
            <option value="1" selected>1</option>
            <option value="2">2</option>
            <option value="3">3</option>
            <option value="4">4</option>
            <option value="5">5</option>
        </select>
    </div>
    <div>
        <br>
        <button class="addToCartButton" onclick="addToCart(document.getElementById('ID').value)">Add to Cart</button>
        <br>
    </div>
    <footer id="footer">
        <!--Checkout-->
        <button class="menuButton" id="checkoutButton">Checkout</button>
        <br>
        <button class="menuButton" id="buttonPreviousPage">Back to previous page</button>
        <p id="projectInformation"> G00438840 Web Application Development Project, ATU Galway 2025. </p>
    </footer>
</body>
        
</html>
<script>
        
    function addToCart(ID) {
        var ID = parseInt(ID);
        var Name = document.getElementById("Name").innerHTML.trim();
        var Price = document.getElementById("Price").innerHTML.trim();
        var Category = document.getElementById("Category").innerHTML.trim();
        let Quantity = parseInt(document.getElementById("quantity").value);
        
        let productData = {
            ID: ID,
            Name: Name,
            Price: Price,
            Category: Category,
            Quantity: Quantity
            };
        
            var cartItems = JSON.parse(localStorage.getItem('cartItems')) || [];
        
            var existingProductIndex = cartItems.findIndex(item => item.ID === productData.ID);
        
            if (existingProductIndex > -1) {
                cartItems[existingProductIndex].Quantity += productData.Quantity;
                } else {
                    cartItems.push(productData);
                }
                localStorage.setItem('cartItems', JSON.stringify(cartItems));
                alert("Added to cart: " + Name + "( x" + Quantity + ")");
            }
            '--------------------------------------------------------------------------------------------------------------------------------'
            'Button to navigate to previous page'
            document.addEventListener('DOMContentLoaded', function () {
                const buttonPreviousPage = document.getElementById("buttonPreviousPage");
                if (buttonPreviousPage) {
                    buttonPreviousPage.addEventListener('click', function () {
                        window.history.back();
                    });
                } else {
                    console.error("Back to previous page button not working");
                }
            });
            `Checkout Button`
            document.addEventListener('DOMContentLoaded', function () {
                const checkoutButton = document.getElementById('checkoutButton');
                if (checkoutButton) {
                    checkoutButton.addEventListener('click', function () {
                        window.location.href = 'checkout';
                        console.log("Going to checkout page");
                    });
                }
                else {
                    console.warn("Error : Checkout Button did not work. ");
                }
            });
</script>