<!DOCTYPE html>
<html>
<!--Header-->

<head>
  <link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"
  integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
  <link rel="stylesheet" href="/css/style.css" type="text/css">
  <div id="Heading">
    <title>Paul's Clothing Website</title>
    <div id="pageHeader">
      <h1>
        <b><i>
            Established in 2025.
          </i></b>
      </h1>
    </div>
</head>
<!--Body-->

<body>
  <div id="Heading">
    </div>
    <div id="logo">
      <header>
        <a href='/homepage'>
          <img src="/images/logo.jpeg" id="logo-img" alt="Paul's Clothing Logo" title="Our logo. " width="200"
            height="200" />
        </a>
      </header>
      <br>
    </div>

    <!--Basket-->
    <div id="message">
      <p> ------------------------------------</p>
      <p id="cart_items">Your basket:</p>
      <p> ------------------------------------</p>
      <p id="cartFinalPrice">Total Price:</p>
    </div>
    <br>
    <!--Details-->
    <div id="product_Description">
      <form>
        <label for="name">Name:</label>
        <br>
        <input id="inputBox" type="text" id="name" name="name" required>
        <br>
        <br>
        <label for="email">Email:</label>
        <br>
        <input id="inputBox" type="email" id="email" name="email" required>
        <br>
        <br>
        <label for="address">Address:</label>
        <br>
        <textarea id="inputBox" id="address" name="address" required></textarea>
        <br>
        <br>
        <label for="payment">Payment Method:</label>
        <br>
        <select id="payment" name="payment">
          <br>
          <br>
          <option value="paymentMethod">Credit / Debit Card</option>
          <br>
          <option value="paymentMethod">Gift Voucher</option>
          <br>
          <option value="paymentMethod">Customer Loyalty Points</option>
          <br>
          <option value="paymentMethod">Pay in store</option>
        </select>
      </form>
      <br>
    </div>
    <!--Button-->
    <div class="button-containier">
      <br>
      <button class = "menuButton" id="placeOrderButton" type="submit">Place Order</button>
      <br>
    </div>
    <footer id="footer">
      <!--Checkout-->
      <button class="menuButton" id="checkoutButton">Checkout</button>
      <br>
      <button class="menuButton" id="buttonPreviousPage">Back to previous page</button>
      <p id="projectInformation"> G00438840 Web Application Development Project, ATU Galway 2025. </p>
    </footer>
</body>

</html>
<script>
  const placeOrderButton = document.getElementById("placeOrderButton");
  if(placeOrderButton){
    placeOrderButton.addEventListener('click', function(){
      console.log("Order placed");
      alert("Order placed!");
    });
  }else{
    console.error("Place Order button not working"); 
  }

  const buttonPreviousPage = document.getElementById("buttonPreviousPage");
  if (buttonPreviousPage) {
    buttonPreviousPage.addEventListener('click', function () {
      window.history.back();
    });
  } else {
    console.error("Back to previous page button not working");
  }

  const cartItems = document.getElementById("cart_items");
  const cartFinalPrice = document.getElementById("cartFinalPrice");

  if (!cartItems) {
    console.error("HTML element with ID 'cart_items' not found!");
  } else {
    const storedCart = localStorage.getItem('cartItems');
    let cart = [];
    let grandTotal = 0;

    if (storedCart) {
      try {
        cart = JSON.parse(storedCart);
        if (!Array.isArray(cart)) {
          console.error("Data stored under 'cartItems' is not an array. Resetting cart.");
          cart = [];
        }
      } catch (e) {
        console.error("Error parsing 'cartItems' from localStorage:", e);
        cart = [];
      }
    }

    cartItems.innerHTML = "Your basket:<br>";
    cartFinalPrice.innerHTML = "Total Price: €0.00";

    if (cart.length === 0) {
      cartItems.innerHTML = "Your basket is empty.";
      cartFinalPrice.innerHTML = "Total Price : €0.00";
    } else {
      cart.forEach(productData => {
        if (typeof productData === 'object' && productData !== null &&
          productData.Name !== undefined && productData.Quantity !== undefined && productData.Price !== undefined) {

          const name = productData.Name;
          const quantity = productData.Quantity;
          const price = productData.Price;

          if (quantity > 0) {
            const total_cost = quantity * price;
            cartItems.innerHTML += `${name} ( x ${quantity} ) = €${total_cost.toFixed(2)}<br>`;
            grandTotal += total_cost;
          }
        } else {
          console.warn("Invalid product data found in cart:", productData);
        }
      });
      cartFinalPrice.innerHTML = `Total Price : €${grandTotal.toFixed(2)}`;
    }
  }
  '--------------------------------------------------------------------------------------------------------------------------------'
  'Button to navigate to previous page'
  document.addEventListener('DOMContentLoaded', function () {
    const buttonPreviousPage = document.getElementById("buttonPreviousPage");
    if (buttonPreviousPage) {
      buttonPreviousPage.addEventListener('click', function () {
        window.history.back();
      });
    } else {
      console.error("Back to previous page button not working");
    }
  });
  `Checkout Button`
  document.addEventListener('DOMContentLoaded', function () {
        const checkoutButton = document.getElementById('checkoutButton');
        if (checkoutButton) {
            checkoutButton.addEventListener('click', function () {
                window.location.href = 'checkout';
                console.log("Going to checkout page");
                checkoutButton.removeEventListener('click','DOMContentLoaded'); 
            });
        }
        else {
            console.warn("Error : Checkout Button did not work. ");
        }
    }
    );
</script>