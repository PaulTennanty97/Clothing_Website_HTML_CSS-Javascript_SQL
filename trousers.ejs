<!DOCTYPE html>
<!--Html-->
<html id="page" lang="en">

<!--Head-->

<head>
    <link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"
        integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
    <link rel="stylesheet" href="/css/style.css" type="text/css">

</head>
<!--Body-->

<body>
    <div id="Heading">
        <title>Paul's Clothing Website</title>
        <div id="pageHeader">
            <h1>
                <b><i>
                        Established in 2025.
                </i></b>
            </h1>
        </div>
        <div id="logo">
            <header>
                <a href='/homepage'>
                    <img src="/images/logo.jpeg" id="logo-img" alt="Paul's Clothing Logo" title="Our logo. " width="200"
                        height="200" />
                </a>
            </header>
            <br>
        </div>
        <div id="message">
            <p>
                Take a look at what trousers we have in stock!
            </p>
        </div>
        <div id="product_Description">
            <br>
            <button class="menuButton" id = "ID1Button">Blue Jeans</button><br>
            <br>
            <button class="menuButton" id = "ID7Button">Navy Trousers</button><br>
        </div>
        <footer id="footer">
            <!--Checkout-->
            <button class="menuButton" id="checkoutButton">Checkout</button>
            <br>
            <button class="menuButton" id="buttonPreviousPage">Back to previous page</button>
            <p id="projectInformation"> G00438840 Web Application Development Project, ATU Galway 2025. </p>
        </footer>
</body>
<!--Body-->

</html>
<!--html-->

<!--script-->
<script>
    const buttonPreviousPage = document.getElementById("buttonPreviousPage");
    if (buttonPreviousPage) {
        buttonPreviousPage.addEventListener('click', function () {
            window.history.back();
        });
    } else {
        console.error("Back to previous page button not working");
    }
    'Button to ID1'
    document.addEventListener('DOMContentLoaded', function () {
        const ID1Button = document.getElementById('ID1Button');
        if (ID1Button) {
            ID1Button.addEventListener('click', function () {
                window.location.href = '/ID1?rec=1';
                console.log("Going to the ID1 page");
            });
        }
        else {
            console.warn("Error : The ID1 Button did not work. ");
        }
    }
    );
    'Button to ID7'
    document.addEventListener('DOMContentLoaded', function () {
        const ID7Button = document.getElementById('ID7Button');
        if (ID7Button) {
            ID7Button.addEventListener('click', function () {
                window.location.href = '/ID7?rec=7';
                console.log("Going to the ID7 page");
            });
        }
        else {
            console.warn("Error : The ID7 Button did not work. ");
        }
    }
    );
    '--------------------------------------------------------------------------------------------------------------------------------'
    'Button to navigate to previous page'
    document.addEventListener('DOMContentLoaded', function () {
        const buttonPreviousPage = document.getElementById("buttonPreviousPage");
        if (buttonPreviousPage) {
            buttonPreviousPage.addEventListener('click', function () {
                window.history.back();
            });
        } else {
            console.error("Back to previous page button not working");
        }
    });
    `Checkout Button`
    document.addEventListener('DOMContentLoaded', function () {
        const checkoutButton = document.getElementById('checkoutButton');
        if (checkoutButton) {
            checkoutButton.addEventListener('click', function () {
                window.location.href = 'checkout';
                console.log("Going to checkout page");
            });
        }
        else {
            console.warn("Error : Checkout Button did not work. ");
        }
    });
</script>
<!--script-->