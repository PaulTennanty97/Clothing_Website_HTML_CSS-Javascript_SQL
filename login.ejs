<!DOCTYPE html>
<!--HTML-->
<html id="page" lang="en">
  <!--Head-->
  <head>
    <link
      href="https://fonts.googleapis.com/icon?family=Material+Icons"
      rel="stylesheet"
    />
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
      rel="stylesheet"
      integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH"
      crossorigin="anonymous"
    />
    <link rel="stylesheet" href="/css/style.css" type="text/css" />
    <title>Paul's Clothing Website</title>
  </head>
  <!--Head-->

  <!--Body-->
  <body>
    <div id="Heading">
      <div id="pageHeader">
        <h1>
          <b><i> Established in 2025. </i></b>
        </h1>
      </div>
    </div>
    <div id="logo">
      <header>
        <a href="/homepage">
          <img
            src="/images/logo.jpeg"
            id="logo-img"
            alt="Paul's Clothing Logo"
            title="Our logo. "
            width="200"
            height="200"
          />
        </a>
      </header>
      <br />
    </div>
    <div id="message">
      <p>
        Welcome to <em><b>Paul's Clothing Store!</b></em> <br />
        <br />
        Since 2025, here at our website, you can browse various different
        clothing items. Once you find the perfect piece, don't be shy and add an
        item to your basket.<br />
        <br />
        We have a small selection of goods available to browse!
      </p>
      <p>
        To enter our online store, you will need your login details to hand.<br />
        Please login to your account below.
      </p>
      <form id="loginForm" action="/login" method="POST">
        <label for="email">Username:</label><br />
        <input type="text" id="email" name="email" required /><br />
        <br />
        <label for="password"> Password:</label><br />
        <input type="password" id="password" name="password" required /><br />
        <br />
        <button class="menuButton" id="button" type="submit">Login</button>
        <br />
      </form>
    </div>
    <footer id="footer">
      <br />
      <p id="projectInformation">
        G00438840 Web Application Development Project, ATU Galway 2025.
      </p>
    </footer>
  </body>
  <!--BODY-->
</html>
<!--HTML-->

<!--Script-->
<script>
  const form = document.getElementById("loginForm");
  form.addEventListener("submit", function (event) {
    event.preventDefault();

    const email = document.getElementById("email").value;
    const password = document.getElementById("password").value;

    fetch("/login", {
      method: "POST",
      headers: {
        "Content-Type": "application/json",
      },
      body: JSON.stringify({ email, password }),
    })
      .then((response) => response.json())
      .then((data) => {
        if (data.authenticated) {
          window.location.href = "/homepage";
        } else {
          alert("Authentication failed. Please try again");
        }
      })
      .catch((error) => {
        console.error("Caught error:", error);

        alert(
          `An error occurred: ${
            error.message || "Unknown error"
          }. Please check console for details.`
        );
      });
  });
</script>
<!--Script-->
