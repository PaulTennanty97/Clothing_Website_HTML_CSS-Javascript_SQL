<!DOCTYPE html>
<html id="page" lang="en">
  <!--Heading-->
  <!--Head-->

  <head>
    <link
      href="https://fonts.googleapis.com/icon?family=Material+Icons"
      rel="stylesheet"
    />
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
      rel="stylesheet"
      integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH"
      crossorigin="anonymous"
    />
    <link rel="stylesheet" href="/css/style.css" type="text/css" />
  </head>
  <!--Body-->

  <body style="min-height: 100vh; display: flex; flex-direction: column">
    <div id="Heading">
      <title>Paul's Clothing Website</title>
      <div id="pageHeader">
        <h1>
          <b><i> Established in 2025. </i></b>
        </h1>
      </div>
    </div>
    <div id="logo">
      <header>
        <a href="/homepage">
          <img
            src="/images/logo.jpeg"
            id="logo-img"
            alt="Paul's Clothing Logo"
            title="Our logo. "
            width="200"
            height="200"
          />
        </a>
      </header>
      <br />
    </div>

    <!--Slideshow----------------------------------------------------------------------------------------------------------------->
    <!--Source: Youtube video - https://www.youtube.com/watch?v=4YQ4svkETS0
    I don't fully understand all the working of the carousel code but chose to adapt as it demonstrates
    HTML, CSS and JS working together. -->
    <div id="slideshowDiv">
      <img id="slide-image" width="400" height="200" />
    </div>
    <!--Homepage Message--------------------------------------------------------------------------------------------------------->
    <div id="message">
      <p>
        Take a browse through our limited stock of available items below.<br />
        <br />
        From your favourite sports jerseys, the fastest runners, jeans and
        hoodies, we have it all here at Pauls!
      </p>
    </div>
    <!--Homepage------------------------------------------------------------------------------------------------------------------>
    <div id="product_Description">
      <ul>
        <button class="menuButton" id="footwearButton">Footwear</button
        ><br />
        <br />
        <button class="menuButton" id="trousersButton">Trousers</button
        ><br />
        <br />
        <button class="menuButton" id="jumpersButton">Jumpers</button
        ><br />
        <br />
        <button class="menuButton" id="tShirtsButton">T Shirts</button
        ><br />
        <br />
        <button class="menuButton" id="jerseysButton">Jerseys</button
        ><br />
      </ul>
      <br />
    </div>
    <footer id="footer">
      <!--Checkout-->
      <button class="menuButton" id="checkoutButton">Checkout</button>
      <br />
      <button class="menuButton" id="buttonPreviousPage">
        Back to previous page
      </button>
      <p id="projectInformation">
        G00438840 Web Application Development Project, ATU Galway 2025.
      </p>
    </footer>
  </body>
  <!--Body----------------------------------------------------------------------------------------------------------------------->
  <!--html----------------------------------------------------------------------------------------------------------------------->
</html>
<!--html-->
<script>
  "buttons for the menu on the homepage.";
  const footwearButton = document.getElementById("footwearButton");
  const trousersButton = document.getElementById("trousersButton");
  const jumpersButton = document.getElementById("jumpersButton");
  const tShirtsButton = document.getElementById("tShirtsButton");
  const JerseysButton = document.getElementById("jerseysButton");
  ("Footwear Button");
  document.addEventListener("DOMContentLoaded", function () {
    const footwearButton = document.getElementById("footwearButton");
    if (footwearButton) {
      footwearButton.addEventListener("click", function () {
        window.location.href = "footwear";
        console.log("Going to the Footwear page");
      });
    } else {
      console.warn("Error : The Footwear Button did not work. ");
    }
  });
  ("Trousers Button");
  document.addEventListener("DOMContentLoaded", function () {
    const trousersButton = document.getElementById("trousersButton");
    if (trousersButton) {
      trousersButton.addEventListener("click", function () {
        window.location.href = "trousers";
        console.log("Going to the trousers page");
      });
    } else {
      console.warn("Error : The trousers button did not work. ");
    }
  });
  ("Jumpers Button");
  document.addEventListener("DOMContentLoaded", function () {
    const jumpersButton = document.getElementById("jumpersButton");
    if (jumpersButton) {
      jumpersButton.addEventListener("click", function () {
        window.location.href = "jumpers";
        console.log("Going to the jumpers page");
      });
    } else {
      console.warn("Error : The jumpers button did not work. ");
    }
  });
  ("Tshirts Button");
  document.addEventListener("DOMContentLoaded", function () {
    const tShirtsButton = document.getElementById("tShirtsButton");
    if (tShirtsButton) {
      tShirtsButton.addEventListener("click", function () {
        window.location.href = "tShirts";
        console.log("Going to the T Shirts page");
      });
    } else {
      console.warn("Error : the T shirt Button did not work. ");
    }
  });
  ("Jerseys Button");
  document.addEventListener("DOMContentLoaded", function () {
    const jerseysButton = document.getElementById("jerseysButton");
    if (jerseysButton) {
      jerseysButton.addEventListener("click", function () {
        window.location.href = "jerseys";
        console.log("Going to the jerseys page");
      });
    } else {
      console.warn("Error : The jerseys button did not work. ");
    }
  });

  ("--------------------------------------------------------------------------------------------------------------------------------");
  ("Button to navigate to previous page");
  document.addEventListener("DOMContentLoaded", function () {
    const buttonPreviousPage = document.getElementById("buttonPreviousPage");
    if (buttonPreviousPage) {
      buttonPreviousPage.addEventListener("click", function () {
        window.history.back();
      });
    } else {
      console.error("Back to previous page button not working");
    }
  });
  `Checkout Button`;
  document.addEventListener("DOMContentLoaded", function () {
    const checkoutButton = document.getElementById("checkoutButton");
    if (checkoutButton) {
      checkoutButton.addEventListener("click", function () {
        window.location.href = "checkout";
        console.log("Going to checkout page");
      });
    } else {
      console.warn("Error : Checkout Button did not work. ");
    }
  });

  ("--------------------------------------------------------------------------------------------------------------------------------");
  ("Slideshow");
  var i = 0;
  var images = [];
  var time = 1500;

  //Image list
  images[0] = "/images/A.jpeg";
  images[1] = "/images/B.jpeg";
  images[2] = "/images/C.jpeg";

  function changeImg() {
    document.getElementById("slide-image").src = images[i];
    if (i < images.length - 1) {
      i++;
    } else {
      i = 0;
    }
    setTimeout("changeImg()", time);
  }
  window.onload = changeImg;
</script>
